#!/usr/bin/env bash
# install.sh — installs libplatemaker @PROJECT_VERSION@ from the extracted tarball.
#
# Usage:
#   ./install.sh               # installs to /usr/local
#   ./install.sh /some/prefix  # installs to a custom prefix (no root needed)
#
# The script detects automatically whether elevated privileges are required.
# If they are, it re-executes itself via sudo after printing a clear explanation.
#
# Prerequisites:
#   libvips must be installed. If pkg-config cannot find it, the script will
#   print the correct install command for your package manager and exit.
set -euo pipefail

PREFIX="${1:-/usr/local}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Check for libvips >= 8.15 ───────────────────────────────────────────────────
# libplatemaker @PROJECT_VERSION@ is built against libvips 8.15 (ImageIO::save uses the 8.15 "keep"
# metadata option); an older runtime libvips rejects it at save time, so gate on the version here.
if ! pkg-config --exists vips-cpp 2>/dev/null; then
    echo "ERROR: libvips not found. Install libvips >= 8.15 first:"
    if   command -v apt-get &>/dev/null; then echo "  sudo apt install libvips-dev   (Ubuntu 24.04+ ships 8.15)"
    elif command -v dnf     &>/dev/null; then echo "  sudo dnf install vips-devel"
    elif command -v pacman  &>/dev/null; then echo "  sudo pacman -S libvips"
    else echo "  install libvips (>= 8.15) via your distribution's package manager"
    fi
    exit 1
elif ! pkg-config --atleast-version=8.15 vips-cpp 2>/dev/null; then
    echo "ERROR: libvips $(pkg-config --modversion vips-cpp 2>/dev/null || echo '?') found, but"
    echo "libplatemaker @PROJECT_VERSION@ requires libvips >= 8.15."
    echo "Upgrade libvips (e.g. Ubuntu 24.04+ ships 8.15), then re-run this script."
    exit 1
fi

# ── Privilege check ────────────────────────────────────────────────────────────
# Walk up to the nearest existing ancestor of PREFIX to test writability.
_writable_ancestor() {
    local dir="$1"
    while [[ ! -e "$dir" ]]; do dir="$(dirname "$dir")"; done
    [[ -w "$dir" ]]
}

if ! _writable_ancestor "$PREFIX" && [[ $EUID -ne 0 ]]; then
    if ! command -v sudo &>/dev/null; then
        echo "ERROR: '$PREFIX' is not writable and sudo is not available."
        echo "Either run as root or choose a writable prefix:"
        echo "  ./install.sh \$HOME/.local"
        exit 1
    fi
    echo "Installing libplatemaker @PROJECT_VERSION@ to '$PREFIX'."
    echo "This directory requires administrator privileges."
    echo "The following files will be written:"
    echo "  $PREFIX/lib/libplatemaker.so*"
    echo "  $PREFIX/lib/cmake/platemaker/"
    echo "  $PREFIX/lib/pkgconfig/platemaker.pc"
    echo "  $PREFIX/include/platemaker/"
    echo ""
    echo "You will be prompted for your password (sudo)."
    exec sudo "$0" "$@"
fi

# ── Copy library, headers, CMake config ───────────────────────────────────────
mkdir -p "$PREFIX/lib/pkgconfig" \
         "$PREFIX/include" \
         "$PREFIX/lib/cmake/platemaker"

cp -a "$SCRIPT_DIR"/lib/libplatemaker.so*  "$PREFIX/lib/"
cp -r "$SCRIPT_DIR"/include/*              "$PREFIX/include/"
cp    "$SCRIPT_DIR"/lib/cmake/platemaker/* "$PREFIX/lib/cmake/platemaker/"

# ── Generate pkg-config file ──────────────────────────────────────────────────
cat > "$PREFIX/lib/pkgconfig/platemaker.pc" <<PKGEOF
prefix=$PREFIX
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: platemaker
Description: @PROJECT_DESCRIPTION@
Version: @PROJECT_VERSION@
Libs: -L\${libdir} -lplatemaker
Cflags: -I\${includedir}
Requires: vips-cpp >= 8.15
PKGEOF

# ── Update linker cache ────────────────────────────────────────────────────────
ldconfig 2>/dev/null || true

echo "libplatemaker @PROJECT_VERSION@ installed to $PREFIX"
echo ""
echo "CMake:      find_package(platemaker CONFIG REQUIRED HINTS \"$PREFIX/lib/cmake/platemaker\")"
echo "pkg-config: PKG_CONFIG_PATH=$PREFIX/lib/pkgconfig pkg-config --libs platemaker"
