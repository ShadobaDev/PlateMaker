#!/usr/bin/env bash
# install.sh — installs platemaker-cli @PROJECT_VERSION@ from the extracted tarball.
#
# Usage:
#   ./install.sh               # installs to /usr/local  (may need sudo)
#   ./install.sh /some/prefix  # installs to a custom prefix (no root needed)
#
# Prerequisites:
#   libvips must be installed. If it is missing, the script prints the correct
#   install command for your package manager and exits.
set -euo pipefail

PREFIX="${1:-/usr/local}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Check the runtime libvips is present and >= 8.15 ────────────────────────────
# platemaker-cli @PROJECT_VERSION@ is built against libvips 8.15 (it saves with the 8.15 "keep" metadata
# option; an older runtime libvips rejects that at save time). End users usually have only the libvips
# *runtime* — not the -dev package that ships pkg-config's .pc — so instead of pkg-config we ask the
# bundled binary itself: it links libvips and prints the runtime version via vips_version(), and running
# it also proves the runtime actually loads. Point LD_LIBRARY_PATH at the bundled (not-yet-installed)
# libplatemaker.so so the binary can start before it is copied into place.
CLI_BIN="$SCRIPT_DIR/bin/platemaker-cli"
if ! _vips_report="$(LD_LIBRARY_PATH="$SCRIPT_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$CLI_BIN" --version 2>/dev/null)"; then
    echo "ERROR: platemaker-cli could not start — the libvips runtime is missing or incompatible."
    echo ""
    echo "Install libvips (>= 8.15) with your package manager:"
    if   command -v apt-get &>/dev/null; then echo "  sudo apt install libvips   (Ubuntu 24.04+ ships 8.15)"
    elif command -v dnf     &>/dev/null; then echo "  sudo dnf install vips"
    elif command -v pacman  &>/dev/null; then echo "  sudo pacman -S libvips"
    elif command -v zypper  &>/dev/null; then echo "  sudo zypper install libvips"
    else echo "  install libvips (>= 8.15) via your distribution's package manager"
    fi
    echo ""
    echo "Then re-run this script."
    exit 1
fi

# Parse the "libvips X.Y.Z (…)" line (the runtime version from vips_version()).
_vips_ver="$(printf '%s\n' "$_vips_report" | sed -n 's/^libvips \([0-9][0-9.]*\).*/\1/p' | head -n1)"
if [[ -z "$_vips_ver" ]]; then
    echo "WARNING: platemaker-cli ran but its libvips version could not be read; continuing."
elif ! printf '8.15\n%s\n' "$_vips_ver" | sort -V -C 2>/dev/null; then
    echo "ERROR: libvips $_vips_ver found, but platemaker-cli @PROJECT_VERSION@ requires libvips >= 8.15."
    echo "Upgrade libvips (e.g. Ubuntu 24.04+ ships 8.15), then re-run this script."
    exit 1
fi

# ── Privilege check ────────────────────────────────────────────────────────────
_writable_ancestor() {
    local dir="$1"
    while [[ ! -e "$dir" ]]; do dir="$(dirname "$dir")"; done
    [[ -w "$dir" ]]
}

if ! _writable_ancestor "$PREFIX" && [[ $EUID -ne 0 ]]; then
    if ! command -v sudo &>/dev/null; then
        echo "ERROR: '$PREFIX' is not writable and sudo is not available."
        echo "Run as root or choose a writable prefix:"
        echo "  ./install.sh \$HOME/.local"
        exit 1
    fi
    echo "Installing platemaker-cli @PROJECT_VERSION@ to '$PREFIX'."
    echo "This directory requires administrator privileges — you will be prompted for your password."
    exec sudo "$0" "$@"
fi

# ── Install ────────────────────────────────────────────────────────────────────
mkdir -p "$PREFIX/bin" "$PREFIX/lib"

install -m 755 "$SCRIPT_DIR/bin/platemaker-cli" "$PREFIX/bin/"
cp -a "$SCRIPT_DIR"/lib/libplatemaker.so*       "$PREFIX/lib/"

# ── Update linker cache ────────────────────────────────────────────────────────
if command -v ldconfig &>/dev/null; then
    ldconfig 2>/dev/null || true
fi

echo ""
echo "platemaker-cli @PROJECT_VERSION@ installed."
echo "  binary : $PREFIX/bin/platemaker-cli"
echo "  library: $PREFIX/lib/libplatemaker.so"

# Warn if prefix/bin is not on PATH
if [[ ":$PATH:" != *":$PREFIX/bin:"* ]]; then
    echo ""
    echo "NOTE: '$PREFIX/bin' is not in your PATH. Add this to ~/.bashrc or ~/.zshrc:"
    echo "  export PATH=\"$PREFIX/bin:\$PATH\""
fi
