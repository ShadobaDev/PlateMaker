// Windows version resource for libplatemaker.dll — the metadata Explorer's "Details" tab and Process
// Explorer read (product name, version, company, description, copyright). Generated by CMake from the
// project version via configure_file(@ONLY); edit this template, never the generated .rc in the build.

1 VERSIONINFO   // resource id 1 = RT_VERSION (VS_VERSION_INFO); numeric so no winver.h needed
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L   // VOS_NT_WINDOWS32
 FILETYPE       0x2L       // VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // US English (0x0409), Unicode (0x04b0 = 1200)
        BEGIN
            VALUE "CompanyName",      "ShadobaDev (Bartlomiej Mucha)"
            VALUE "FileDescription",  "libplatemaker - Platemaker processing library"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "libplatemaker"
            VALUE "LegalCopyright",   "Copyright (C) 2026 ShadobaDev (Bartlomiej Mucha) - LGPL-3.0-or-later"
            VALUE "OriginalFilename", "libplatemaker.dll"
            VALUE "ProductName",      "libplatemaker"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
