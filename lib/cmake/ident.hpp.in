#pragma once

// -----------------------------------------------------------------------------
// Generated by CMake from lib/cmake/ident.hpp.in — do NOT edit by hand.
// Single source of truth is the root project(platemaker VERSION ...) declaration.
//
// A single, contiguous version-marker string literal embedded in the binary so the
// version is discoverable *without running it* on platforms that have no Windows-style
// VERSIONINFO resource (Linux, macOS):
//
//   what    libplatemaker.so.0.4.1            →  platemaker <ver> (libplatemaker)
//   strings libplatemaker.so.0.4.1 | grep @(#)
//
// The "@(#)" prefix is the SCCS / `what(1)` convention (also trivially greppable). The
// consuming TU appends its own component tag via adjacent-literal concatenation, e.g.
// PLATEMAKER_IDENT_STRING " (libplatemaker)".
//
// This header is PRIVATE to the build tree — it is NOT installed and NOT part of the
// public API. Only the library's build_info.cpp and the CLI's main.cpp embed the marker.
// -----------------------------------------------------------------------------

#define PLATEMAKER_IDENT_STRING "@(#)@PROJECT_NAME@ @PROJECT_VERSION@"
