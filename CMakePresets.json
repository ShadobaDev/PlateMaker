{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },

  "configurePresets": [

    {
      "name": "base",
      "hidden": true,
      "description": "Shared defaults inherited by all concrete presets.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLATEMAKER_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "linux-base",
      "hidden": true,
      "description": "Shared Linux / WSL2 GCC settings.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CPACK_SYSTEM_NAME": "linux-x86_64"
      }
    },

    {
      "name": "mingw-base",
      "hidden": true,
      "description": "Shared Windows MinGW (MSYS2) GCC + Ninja settings. Requires the MSYS2 mingw-w64 toolchain; libvips is fetched automatically (the slim web build) — no mingw-w64-x86_64-libvips or PKG_CONFIG_PATH needed.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CPACK_SYSTEM_NAME": "windows-mingw"
      }
    },

    {
      "name": "msvc-base",
      "hidden": true,
      "description": "Shared Windows MSVC (VS 2022) settings. libvips auto-fetched.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "host=x64", "strategy": "set" },
      "cacheVariables": {
        "CPACK_SYSTEM_NAME": "windows-msvc"
      }
    },

    {
      "name": "linux-release",
      "displayName": "Linux · GCC · Release",
      "description": "libvips from apt; nlohmann-json and gtest from source if not found.",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "linux-debug",
      "displayName": "Linux · GCC · Debug",
      "description": "Plain Debug build (full symbols, no sanitizer) — packageable.",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },

    {
      "name": "linux-asan",
      "displayName": "Linux · GCC · Debug + ASan/UBSan (local only)",
      "description": "Local sanitizer build — NOT for packaging (requires libasan at runtime).",
      "inherits": "linux-debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer -g"
      }
    },

    {
      "name": "linux-coverage",
      "displayName": "Linux · GCC · Debug + coverage (gcovr)",
      "description": "Instrumented Debug build for the coverage report (CI) — NOT for packaging.",
      "inherits": "linux-debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "--coverage -fprofile-update=atomic",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage",
        "CMAKE_MODULE_LINKER_FLAGS": "--coverage"
      }
    },

    {
      "name": "mingw-release",
      "displayName": "Windows · MinGW · Release",
      "description": "MinGW GCC (MSYS2) + Ninja, Release.",
      "inherits": "mingw-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "mingw-debug",
      "displayName": "Windows · MinGW · Debug",
      "description": "MinGW GCC (MSYS2) + Ninja, Debug (full symbols).",
      "inherits": "mingw-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },

    {
      "name": "msvc-release",
      "displayName": "Windows · MSVC · Release",
      "description": "MSVC toolchain via VS 2022, Release. (Secondary — GUI links with MinGW.)",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },

    {
      "name": "msvc-debug",
      "displayName": "Windows · MSVC · Debug",
      "description": "MSVC toolchain via VS 2022, Debug.",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },

    {"name": "dist-linux-release", "displayName": "Dist · linux-release (no tests)", "description": "linux-release for the release script: tests are not built, and it installs where linux-release does.", "inherits": "linux-release", "installDir": "${sourceDir}/install/linux-release", "cacheVariables": {"PLATEMAKER_BUILD_TESTS": "OFF"}},
    {"name": "dist-linux-debug", "displayName": "Dist · linux-debug (no tests)", "description": "linux-debug for the release script: tests are not built, and it installs where linux-debug does.", "inherits": "linux-debug", "installDir": "${sourceDir}/install/linux-debug", "cacheVariables": {"PLATEMAKER_BUILD_TESTS": "OFF"}},
    {"name": "dist-mingw-release", "displayName": "Dist · mingw-release (no tests)", "description": "mingw-release for the release script: tests are not built, and it installs where mingw-release does.", "inherits": "mingw-release", "installDir": "${sourceDir}/install/mingw-release", "cacheVariables": {"PLATEMAKER_BUILD_TESTS": "OFF"}},
    {"name": "dist-mingw-debug", "displayName": "Dist · mingw-debug (no tests)", "description": "mingw-debug for the release script: tests are not built, and it installs where mingw-debug does.", "inherits": "mingw-debug", "installDir": "${sourceDir}/install/mingw-debug", "cacheVariables": {"PLATEMAKER_BUILD_TESTS": "OFF"}},
    {"name": "dist-msvc-release", "displayName": "Dist · msvc-release (no tests)", "description": "msvc-release for the release script: tests are not built, and it installs where msvc-release does.", "inherits": "msvc-release", "installDir": "${sourceDir}/install/msvc-release", "cacheVariables": {"PLATEMAKER_BUILD_TESTS": "OFF"}},
    {"name": "dist-msvc-debug", "displayName": "Dist · msvc-debug (no tests)", "description": "msvc-debug for the release script: tests are not built, and it installs where msvc-debug does.", "inherits": "msvc-debug", "installDir": "${sourceDir}/install/msvc-debug", "cacheVariables": {"PLATEMAKER_BUILD_TESTS": "OFF"}}

  ],

  "buildPresets": [

    { "name": "linux-release", "displayName": "Build · Linux Release", "configurePreset": "linux-release", "jobs": 0 },
    { "name": "linux-debug",   "displayName": "Build · Linux Debug",   "configurePreset": "linux-debug",   "jobs": 0 },
    { "name": "linux-asan",    "displayName": "Build · Linux Debug+ASan", "configurePreset": "linux-asan", "jobs": 0 },
    { "name": "linux-coverage", "displayName": "Build · Linux Debug+coverage", "configurePreset": "linux-coverage", "jobs": 0 },

    { "name": "mingw-release", "displayName": "Build · MinGW Release", "configurePreset": "mingw-release", "jobs": 0 },
    { "name": "mingw-debug",   "displayName": "Build · MinGW Debug",   "configurePreset": "mingw-debug",   "jobs": 0 },

    { "name": "msvc-release", "displayName": "Build · MSVC Release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "msvc-debug",   "displayName": "Build · MSVC Debug",   "configurePreset": "msvc-debug",   "configuration": "Debug" },

    {"name": "dist-linux-release", "displayName": "Build · Dist linux-release", "configurePreset": "dist-linux-release", "jobs": 0},
    {"name": "dist-linux-debug", "displayName": "Build · Dist linux-debug", "configurePreset": "dist-linux-debug", "jobs": 0},
    {"name": "dist-mingw-release", "displayName": "Build · Dist mingw-release", "configurePreset": "dist-mingw-release", "jobs": 0},
    {"name": "dist-mingw-debug", "displayName": "Build · Dist mingw-debug", "configurePreset": "dist-mingw-debug", "jobs": 0},
    {"name": "dist-msvc-release", "displayName": "Build · Dist msvc-release", "configurePreset": "dist-msvc-release", "configuration": "Release"},
    {"name": "dist-msvc-debug", "displayName": "Build · Dist msvc-debug", "configurePreset": "dist-msvc-debug", "configuration": "Debug"}

  ],

  "testPresets": [

    { "name": "linux-release", "displayName": "Test · Linux Release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-debug",   "displayName": "Test · Linux Debug",   "configurePreset": "linux-debug",   "output": { "outputOnFailure": true } },
    { "name": "linux-asan",    "displayName": "Test · Linux Debug+ASan", "configurePreset": "linux-asan",  "output": { "outputOnFailure": true } },
    { "name": "linux-coverage", "displayName": "Test · Linux Debug+coverage", "configurePreset": "linux-coverage", "output": { "outputOnFailure": true } },

    { "name": "mingw-release", "displayName": "Test · MinGW Release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } },
    { "name": "mingw-debug",   "displayName": "Test · MinGW Debug",   "configurePreset": "mingw-debug",   "output": { "outputOnFailure": true } },

    { "name": "msvc-release", "displayName": "Test · MSVC Release", "configurePreset": "msvc-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "msvc-debug",   "displayName": "Test · MSVC Debug",   "configurePreset": "msvc-debug",   "configuration": "Debug", "output": { "outputOnFailure": true } }

  ],

  "packagePresets": [

    {
      "name": "linux-release",
      "displayName": "Package · Linux Release (dev + cli)",
      "description": "Produces platemaker-dev-<ver>-linux-x86_64-release.tar.gz and platemaker-cli-... in dist/",
      "configurePreset": "linux-release",
      "generators": ["TGZ"]
    },
    {
      "name": "linux-debug",
      "displayName": "Package · Linux Debug (dev + cli)",
      "configurePreset": "linux-debug",
      "generators": ["TGZ"]
    },

    {
      "name": "mingw-release",
      "displayName": "Package · MinGW Release (dev + cli)",
      "description": "Produces platemaker-dev-<ver>-windows-mingw-release.zip and platemaker-cli-... in dist/",
      "configurePreset": "mingw-release",
      "generators": ["ZIP"]
    },
    {
      "name": "mingw-debug",
      "displayName": "Package · MinGW Debug (dev + cli)",
      "configurePreset": "mingw-debug",
      "generators": ["ZIP"]
    },

    {
      "name": "msvc-release",
      "displayName": "Package · MSVC Release (dev + cli)",
      "configurePreset": "msvc-release",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },
    {
      "name": "msvc-debug",
      "displayName": "Package · MSVC Debug (dev + cli)",
      "configurePreset": "msvc-debug",
      "configurations": ["Debug"],
      "generators": ["ZIP"]
    },

    {"name": "dist-linux-release", "displayName": "Package · Linux Release (dev + cli)", "description": "Produces platemaker-dev-<ver>-linux-x86_64-release.tar.gz and platemaker-cli-... in dist/", "configurePreset": "dist-linux-release", "generators": ["TGZ"]},
    {"name": "dist-linux-debug", "displayName": "Package · Linux Debug (dev + cli)", "configurePreset": "dist-linux-debug", "generators": ["TGZ"]},
    {"name": "dist-mingw-release", "displayName": "Package · MinGW Release (dev + cli)", "description": "Produces platemaker-dev-<ver>-windows-mingw-release.zip and platemaker-cli-... in dist/", "configurePreset": "dist-mingw-release", "generators": ["ZIP"]},
    {"name": "dist-mingw-debug", "displayName": "Package · MinGW Debug (dev + cli)", "configurePreset": "dist-mingw-debug", "generators": ["ZIP"]},
    {"name": "dist-msvc-release", "displayName": "Package · MSVC Release (dev + cli)", "configurePreset": "dist-msvc-release", "configurations": ["Release"], "generators": ["ZIP"]},
    {"name": "dist-msvc-debug", "displayName": "Package · MSVC Debug (dev + cli)", "configurePreset": "dist-msvc-debug", "configurations": ["Debug"], "generators": ["ZIP"]}

  ],

  "workflowPresets": [

    {
      "name": "dist-linux-release",
      "displayName": "Dist · Linux Release",
      "description": "Configure → Build → Package (dev + cli tarballs)",
      "steps": [
        { "type": "configure", "name": "dist-linux-release" },
        { "type": "build",     "name": "dist-linux-release" },
        { "type": "package",   "name": "dist-linux-release" }
      ]
    },
    {
      "name": "dist-linux-debug",
      "displayName": "Dist · Linux Debug",
      "description": "Configure → Build → Package (dev + cli tarballs, unstripped)",
      "steps": [
        { "type": "configure", "name": "dist-linux-debug" },
        { "type": "build",     "name": "dist-linux-debug" },
        { "type": "package",   "name": "dist-linux-debug" }
      ]
    },

    {
      "name": "dist-mingw-release",
      "displayName": "Dist · MinGW Release",
      "description": "Configure → Build → Package (dev + cli ZIPs)",
      "steps": [
        { "type": "configure", "name": "dist-mingw-release" },
        { "type": "build",     "name": "dist-mingw-release" },
        { "type": "package",   "name": "dist-mingw-release" }
      ]
    },
    {
      "name": "dist-mingw-debug",
      "displayName": "Dist · MinGW Debug",
      "description": "Configure → Build → Package (dev + cli ZIPs, unstripped)",
      "steps": [
        { "type": "configure", "name": "dist-mingw-debug" },
        { "type": "build",     "name": "dist-mingw-debug" },
        { "type": "package",   "name": "dist-mingw-debug" }
      ]
    },

    {
      "name": "dist-msvc-release",
      "displayName": "Dist · MSVC Release",
      "description": "Configure → Build → Package (dev + cli ZIPs)",
      "steps": [
        { "type": "configure", "name": "dist-msvc-release" },
        { "type": "build",     "name": "dist-msvc-release" },
        { "type": "package",   "name": "dist-msvc-release" }
      ]
    },
    {
      "name": "dist-msvc-debug",
      "displayName": "Dist · MSVC Debug",
      "description": "Configure → Build → Package (dev + cli ZIPs, unstripped)",
      "steps": [
        { "type": "configure", "name": "dist-msvc-debug" },
        { "type": "build",     "name": "dist-msvc-debug" },
        { "type": "package",   "name": "dist-msvc-debug" }
      ]
    }

  ]
}
