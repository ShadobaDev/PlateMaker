{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },

  "configurePresets": [

    {
      "name": "base",
      "hidden": true,
      "description": "Shared defaults inherited by all concrete presets.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLATEMAKER_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "linux-base",
      "hidden": true,
      "description": "Shared Linux / WSL2 GCC settings.",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/build/platemaker/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },

    {
      "name": "linux-system",
      "displayName": "Linux · GCC · Release",
      "description": "libvips from apt; nlohmann-json and gtest from source if not found via apt.",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPACK_SYSTEM_NAME": "linux-x86_64"
      }
    },

    {
      "name": "linux-system-debug",
      "displayName": "Linux · GCC · Debug + ASan",
      "description": "Debug build with AddressSanitizer + UBSan.",
      "inherits": "linux-system",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },

    {
      "name": "windows-msvc",
      "displayName": "Windows · MSVC · Release",
      "description": "Primary Windows build — MSVC toolchain via VS 2022. libvips auto-fetched; nlohmann-json and gtest from source.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPACK_SYSTEM_NAME": "windows-msvc"
      }
    },

    {
      "name": "windows-msvc-debug",
      "displayName": "Windows · MSVC · Debug",
      "description": "Windows debug build — full symbols, no optimisation.",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "windows-msvc-release",
      "displayName": "Windows · MSVC · Release (package)",
      "description": "Release build without tests — used by the package preset and release workflow.",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "PLATEMAKER_BUILD_TESTS": "OFF"
      }
    },

    {
      "name": "windows-mingw",
      "displayName": "Windows · MinGW · Debug",
      "description": "Windows build using MinGW GCC (MSYS2) and Ninja. Requires MSYS2 with mingw-w64-x86_64-libvips and PKG_CONFIG_PATH set.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CPACK_SYSTEM_NAME": "windows-mingw"
      }
    },

    {
      "name": "windows-mingw-release",
      "displayName": "Windows · MinGW · Release (package)",
      "description": "Release build without tests — used by the package preset and release workflow.",
      "inherits": "windows-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLATEMAKER_BUILD_TESTS": "OFF"
      }
    }

  ],

  "buildPresets": [

    {
      "name": "linux-system",
      "displayName": "Build · Linux Release",
      "configurePreset": "linux-system",
      "jobs": 0
    },

    {
      "name": "linux-system-debug",
      "displayName": "Build · Linux Debug",
      "configurePreset": "linux-system-debug",
      "jobs": 0
    },

    {
      "name": "windows-msvc",
      "displayName": "Build · Windows MSVC Release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },

    {
      "name": "windows-msvc-debug",
      "displayName": "Build · Windows MSVC Debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },

    {
      "name": "windows-msvc-release",
      "displayName": "Build · Windows MSVC Release (package)",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },

    {
      "name": "windows-mingw",
      "displayName": "Build · Windows MinGW Debug",
      "configurePreset": "windows-mingw"
    },

    {
      "name": "windows-mingw-release",
      "displayName": "Build · Windows MinGW Release (package)",
      "configurePreset": "windows-mingw-release",
      "jobs": 0
    }

  ],

  "testPresets": [

    {
      "name": "linux-system",
      "displayName": "Test · Linux",
      "configurePreset": "linux-system",
      "output": { "outputOnFailure": true }
    },

    {
      "name": "linux-system-debug",
      "displayName": "Test · Linux Debug",
      "configurePreset": "linux-system-debug",
      "output": { "outputOnFailure": true }
    },

    {
      "name": "windows-msvc",
      "displayName": "Test · Windows MSVC",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },

    {
      "name": "windows-msvc-debug",
      "displayName": "Test · Windows MSVC Debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },

    {
      "name": "windows-mingw",
      "displayName": "Test · Windows MinGW",
      "configurePreset": "windows-mingw",
      "output": { "outputOnFailure": true }
    }

  ],

  "packagePresets": [

    {
      "name": "windows-msvc",
      "displayName": "Package · Windows MSVC Release",
      "description": "Produces platemaker-dev-<ver>-windows-msvc.zip in dist/",
      "configurePreset": "windows-msvc-release",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },

    {
      "name": "windows-mingw",
      "displayName": "Package · Windows MinGW Release",
      "description": "Produces platemaker-dev-<ver>-windows-mingw.zip in dist/",
      "configurePreset": "windows-mingw-release",
      "generators": ["ZIP"]
    },

    {
      "name": "linux-system",
      "displayName": "Package · Linux Release",
      "description": "Produces platemaker-dev-<ver>-linux-x86_64.tar.gz in dist/",
      "configurePreset": "linux-system",
      "generators": ["TGZ"]
    }

  ],

  "workflowPresets": [

    {
      "name": "release-windows-msvc",
      "displayName": "Release workflow · Windows MSVC",
      "description": "Configure → Build (Release, no tests) → Package",
      "steps": [
        { "type": "configure", "name": "windows-msvc-release" },
        { "type": "build",     "name": "windows-msvc-release" },
        { "type": "package",   "name": "windows-msvc" }
      ]
    },

    {
      "name": "release-windows-mingw",
      "displayName": "Release workflow · Windows MinGW",
      "description": "Configure → Build (Release, no tests) → Package",
      "steps": [
        { "type": "configure", "name": "windows-mingw-release" },
        { "type": "build",     "name": "windows-mingw-release" },
        { "type": "package",   "name": "windows-mingw" }
      ]
    },

    {
      "name": "release-linux",
      "displayName": "Release workflow · Linux",
      "description": "Configure → Build (Release) → Package",
      "steps": [
        { "type": "configure", "name": "linux-system" },
        { "type": "build",     "name": "linux-system" },
        { "type": "package",   "name": "linux-system" }
      ]
    }

  ]
}
