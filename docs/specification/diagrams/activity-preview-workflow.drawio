                </mxCell>
                <mxCell id="e_render__f_render" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="render" target="f_render_o" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_why" value="Why the strip is built from INPUTS, not from rendered output&#xa;&#xa;1. It works before the first render. A grade or a bubble has to be authored&#xa;   before it is baked; on an output feed there was nothing to look at.&#xa;2. Rendering does not change the view. Edits preview against the input, so&#xa;   the render bakes what was on screen. On the old feed the render baked the&#xa;   grade into the output and the preview then graded it a second time.&#xa;3. The unit of work is the PAGE — the unit a grade&#39;s per-page exclusions and&#xa;   an overlay&#39;s page anchor both address. An output slice can straddle two&#xa;   pages, so on that feed neither could be honoured at display time at all." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="20" y="1120" width="620" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="n_ungraded" value="Why decodePageToRgba returns the page UNGRADED&#xa;&#xa;Its consumer re-grades on every slider move, and re-decoding a page for&#xa;that would cost roughly 100x what grading the buffer costs. The colour&#xa;step never influences how a page is READ, so a page fetched once stays a&#xa;valid baseline for every grade the user tries on it — which is also why&#xa;the call takes no colour argument at all.&#xa;&#xa;The grade engine is the render&#39;s own (ColourCorrector), so the preview is&#xa;not an approximation of the committed result." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="680" y="1120" width="570" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="n_slices" value="Slices are deliberately absent&#xa;&#xa;Slices are a publishing artifact — files to upload. A viewer draws a&#xa;continuous strip and hides the seams anyway. What the author still needs&#xa;is the slice GRID, drawn as seam guides every sliceHeight down the strip:&#xa;the line a bubble must not be split by." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="280" width="370" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="&lt;span style=&quot;color: rgb(0, 0, 0); text-align: center;&quot;&gt;QGraphicsScene coordinates ARE strip coordinates, 1:1&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="75" y="50" width="370" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="&lt;span style=&quot;color: rgb(0, 0, 0); text-align: center;&quot;&gt;StripItem paints every page in one pass with&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); text-align: center;&quot;&gt;QPainter::Antialiasing OFF — per-page items&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); text-align: center;&quot;&gt;leave a 1px hairline at each join&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="180" width="370" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="cc_on" value="grade enabled AND this page&#xa;not in excludedInputUids ?" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="701" width="320" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="gcache" value="m_gradedCache  —  the graded pixmap, cached separately&#xa;so scrolling inside a page does not re-grade it" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="985" y="870" width="350" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n_baseline" value="Why the ungraded page is kept&#xa;&#xa;The grade is a derived copy, never applied to the resident page.&#xa;That is what makes a page fetched once a valid baseline for every&#xa;grade the user tries on it — a slider drag re-grades from the same&#xa;cached pixels instead of paying ~100x to decode again.&#xa;&#xa;The per-page exclusion is honoured HERE, at display time, by the&#xa;same rule the render applies. It is also why the preview&#39;s unit of&#xa;work is the page: an output slice can straddle an excluded and an&#xa;included page, so on a slice feed the exclusion could not be&#xa;honoured at all." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="460" y="525" width="490" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="e_sharp__lru" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="sharp" target="lru" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_lru__cc_on" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="lru" target="cc_on" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_cc_on__grade" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="cc_on" target="grade" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_grade__gcache" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="grade" target="gcache" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_gcache__join1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" source="gcache" target="join1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_cc_on__join1" value="no — paint the page ungraded" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="cc_on" target="join1" edge="1">
                    <mxGeometry x="-0.4932" y="3" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
            </root>
