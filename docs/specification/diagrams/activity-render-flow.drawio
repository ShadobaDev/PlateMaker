                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1300" y="1260"/>
                            <mxPoint x="1300" y="1630"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_merge_slice__cancel2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="merge_slice" target="cancel2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
