                <mxCell id="e_p2__x_slice" value="throws" style="edgeStyle=isometricEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;arcSize=10;elbow=vertical;" parent="1" source="p2" target="x_slice" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
