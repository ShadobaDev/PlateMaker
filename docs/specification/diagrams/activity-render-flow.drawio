                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="merge_slice" value="" style="rhombus;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="470" y="1610" width="140" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e_rec__merge_slice" value="next slice, then:" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="rec" target="merge_slice" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
