                <mxCell id="e_cancel2__done" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="cancel2" target="done" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_stream" value="Why the save happens inside &lt;br&gt;the callback&lt;br&gt;&lt;br&gt;ScaledStrip streams each slice out and releases&amp;nbsp;source images as it goes. Collecting slices into a&amp;nbsp;list first would hold the whole chapter in RAM; writing them here keeps one slice and about two sources alive at a time, whatever the length." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1156" width="200" height="174" as="geometry"/>
                </mxCell>
                <mxCell id="n_anchor" value="pageTopByInputUid is built here &lt;br&gt;because this loop&amp;nbsp;is the only point in a run where a page&#39;s uid and&amp;nbsp;its strip-Y are both known. &lt;br&gt;&lt;br&gt;&lt;div&gt;A page that failed to&amp;nbsp;load gets no entry, so an overlay anchored to it is&amp;nbsp;reported orphaned instead of landing on a neighbour.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="60" y="640" width="200" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="e_xerr__merge_input" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="x_err" target="merge_input" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1055" y="845"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n_fatal" value="How a fatal slice error leaves the region&#xa;&#xa;writeSlice() returns false, sliceAll() stops streaming and returns&#xa;normally, and render() then sees outcome.failed and returns it.&#xa;The activity ends either way — but nothing is thrown across the&#xa;region boundary, and slices already written stay on disk." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="900" y="1480" width="340" height="120" as="geometry"/>
                </mxCell>
            </root>
