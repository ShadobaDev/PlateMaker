                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="Why this costs a header read per page&#xa;&#xa;scaledPage() is called in full, but every libvips operation it&#xa;builds is lazy: constructing them settles the output dimensions&#xa;and reads the header, and nothing is decoded until a consumer&#xa;pulls a pixel. This function only ever reads .width()/.height()&#xa;off the result, so no pixel is ever pulled.&#xa;&#xa;That is what makes the numbers the RENDER&#39;s own, rather than&#xa;arithmetic that could drift from it." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="470" y="322" width="420" height="159" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="One bad page must not cost the other ninety-nine&#xa;&#xa;The per-page try/catch is why this never throws for a bad file.&#xa;A page that cannot be read comes back with readable = false and&#xa;zero dimensions — exactly as the render skips it — and a consumer&#xa;stacking the layout MUST skip those too, or every page below sits&#xa;at the wrong strip offset." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="467" y="650" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="e_noprof__m_plan" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;" parent="1" source="noprof" target="m_plan" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1140" y="523"/>
                            <mxPoint x="1140" y="815"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
